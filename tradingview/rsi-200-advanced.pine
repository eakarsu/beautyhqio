// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// © Advanced RSI 200 Strategy - FILTERED SIGNALS

//@version=5
indicator("RSI 200 Advanced - Filtered", overlay=false, precision=2)

// ============================================================================
// INPUTS
// ============================================================================

// RSI Settings
rsiLength       = input.int(200, "RSI Length", minval=1)
rsiSource       = input.source(close, "RSI Source")

// Moving Averages on RSI
fastMALength    = input.int(9, "Fast MA Length", minval=1, group="Moving Averages on RSI")
slowMALength    = input.int(21, "Slow MA Length", minval=1, group="Moving Averages on RSI")
maType          = input.string("EMA", "MA Type", options=["SMA", "EMA", "WMA"], group="Moving Averages on RSI")

// Signal Filtering - KEY SETTINGS
minBarsBetween  = input.int(15, "Minimum Bars Between Signals", minval=5, maxval=50, group="Signal Filter", tooltip="Sinyal arasindaki minimum bar sayisi")
rangeLookback   = input.int(20, "Range Detection Lookback", minval=5, group="Signal Filter")
rangeThreshold  = input.float(8.0, "Range Threshold", minval=1.0, maxval=20.0, group="Signal Filter", tooltip="RSI yatay bolge esigi")

// Visual Settings
showAllCrossovers = input.bool(false, "Show ALL Crossovers (Debug)", group="Display")
showFilteredOnly  = input.bool(true, "Show FILTERED Signals Only", group="Display")
showRangeZones    = input.bool(true, "Show Ranging Zones", group="Display")

// Colors
bullColor       = input.color(color.new(#00E676, 0), "Bullish Color", group="Colors")
bearColor       = input.color(color.new(#FF5252, 0), "Bearish Color", group="Colors")
neutralColor    = input.color(color.new(#9E9E9E, 0), "Neutral Color", group="Colors")

// ============================================================================
// RSI CALCULATION
// ============================================================================

rsiValue = ta.rsi(rsiSource, rsiLength)

// ============================================================================
// MOVING AVERAGES ON RSI
// ============================================================================

calcMA(source, length, type) =>
    switch type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "WMA" => ta.wma(source, length)

fastMA = calcMA(rsiValue, fastMALength, maType)
slowMA = calcMA(rsiValue, slowMALength, maType)

// ============================================================================
// RANGE DETECTION (Yatay Piyasa Tespiti)
// ============================================================================

rsiHigh = ta.highest(rsiValue, rangeLookback)
rsiLow = ta.lowest(rsiValue, rangeLookback)
rsiRange = rsiHigh - rsiLow
isRanging = rsiRange < rangeThreshold

// ============================================================================
// RAW CROSSOVERS (Filtrelenmemis)
// ============================================================================

rawBullishCross = ta.crossover(fastMA, slowMA)
rawBearishCross = ta.crossunder(fastMA, slowMA)

// Raw signals (before filtering)
rawLongSignal = rawBullishCross and rsiValue < 50
rawShortSignal = rawBearishCross and rsiValue > 50

// ============================================================================
// SIGNAL FILTERING LOGIC
// Sadece: Ilk giris + Son sinyal
// ============================================================================

// Track bars since last signal
var int barsSinceLastLong = 0
var int barsSinceLastShort = 0
var bool lastLongShown = false
var bool lastShortShown = false

// Increment counters
barsSinceLastLong := barsSinceLastLong + 1
barsSinceLastShort := barsSinceLastShort + 1

// Check if RSI is at extreme levels (always show signal)
isExtreme = rsiValue < 35 or rsiValue > 65

// FILTERED LONG SIGNAL
filteredLongSignal = rawLongSignal and (barsSinceLastLong >= minBarsBetween or isExtreme)

// FILTERED SHORT SIGNAL
filteredShortSignal = rawShortSignal and (barsSinceLastShort >= minBarsBetween or isExtreme)

// Reset counters when signal is shown
if filteredLongSignal
    barsSinceLastLong := 0

if filteredShortSignal
    barsSinceLastShort := 0

// ============================================================================
// TREND ANALYSIS
// ============================================================================

rsiTrendUp = fastMA > slowMA
rsiTrendDown = fastMA < slowMA

// Zones
overbought = rsiValue > 60
oversold = rsiValue < 40
extremeOB = rsiValue > 70
extremeOS = rsiValue < 30

// ============================================================================
// PLOTTING
// ============================================================================

// RSI Line with trend coloring
rsiColor = rsiTrendUp ? bullColor : rsiTrendDown ? bearColor : neutralColor
plot(rsiValue, "RSI 200", color=rsiColor, linewidth=2)

// Moving Averages on RSI
plot(fastMA, "Fast MA", color=color.new(#2196F3, 0), linewidth=1)
plot(slowMA, "Slow MA", color=color.new(#FF9800, 0), linewidth=1)

// Fill between MAs
maFillColor = fastMA > slowMA ? color.new(bullColor, 85) : color.new(bearColor, 85)
fill(plot(fastMA, display=display.none), plot(slowMA, display=display.none), color=maFillColor)

// Reference Lines
hline(50, "Centerline", color=color.new(#757575, 50), linestyle=hline.style_solid)
hline(70, "Overbought", color=color.new(bearColor, 70), linestyle=hline.style_dashed)
hline(30, "Oversold", color=color.new(bullColor, 70), linestyle=hline.style_dashed)
hline(60, "Upper Zone", color=color.new(#9E9E9E, 80), linestyle=hline.style_dotted)
hline(40, "Lower Zone", color=color.new(#9E9E9E, 80), linestyle=hline.style_dotted)

// Ranging zone background
bgcolor(showRangeZones and isRanging ? color.new(color.yellow, 90) : na, title="Ranging Zone")

// ============================================================================
// FILTERED SIGNALS (Ana Sinyaller)
// ============================================================================

// FILTERED Long/Short - SADECE BUNLAR GOSTERILIYOR
plotshape(showFilteredOnly and filteredLongSignal, "LONG", style=shape.labelup, location=location.bottom, color=bullColor, text="LONG", textcolor=color.white, size=size.normal)
plotshape(showFilteredOnly and filteredShortSignal, "SHORT", style=shape.labeldown, location=location.top, color=bearColor, text="SHORT", textcolor=color.white, size=size.normal)

// Debug: Show ALL crossovers (small triangles)
plotshape(showAllCrossovers and rawBullishCross, "Raw Bull Cross", style=shape.triangleup, location=location.bottom, color=color.new(bullColor, 70), size=size.tiny)
plotshape(showAllCrossovers and rawBearishCross, "Raw Bear Cross", style=shape.triangledown, location=location.top, color=color.new(bearColor, 70), size=size.tiny)

// Extreme zone warnings
bgcolor(extremeOB ? color.new(bearColor, 90) : extremeOS ? color.new(bullColor, 90) : na)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(filteredLongSignal, "Filtered Long Signal", "RSI 200: LONG Signal (Filtered)")
alertcondition(filteredShortSignal, "Filtered Short Signal", "RSI 200: SHORT Signal (Filtered)")

// ============================================================================
// INFO TABLE
// ============================================================================

var table infoTable = table.new(position.top_right, 2, 8, bgcolor=color.new(#1E1E1E, 10), border_width=1)

if barstate.islast
    table.cell(infoTable, 0, 0, "RSI 200", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, str.tostring(rsiValue, "#.##"), text_color=rsiColor, text_size=size.small)

    table.cell(infoTable, 0, 1, "Fast MA", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(fastMA, "#.##"), text_color=#2196F3, text_size=size.small)

    table.cell(infoTable, 0, 2, "Slow MA", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(slowMA, "#.##"), text_color=#FF9800, text_size=size.small)

    table.cell(infoTable, 0, 3, "Trend", text_color=color.white, text_size=size.small)
    trendText = rsiTrendUp ? "BULLISH" : rsiTrendDown ? "BEARISH" : "NEUTRAL"
    table.cell(infoTable, 1, 3, trendText, text_color=rsiColor, text_size=size.small)

    table.cell(infoTable, 0, 4, "Ranging", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, isRanging ? "YES" : "NO", text_color=isRanging ? color.yellow : color.white, text_size=size.small)

    table.cell(infoTable, 0, 5, "Bars Since Long", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 5, str.tostring(barsSinceLastLong), text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 6, "Bars Since Short", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 6, str.tostring(barsSinceLastShort), text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 7, "Min Bars Filter", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 7, str.tostring(minBarsBetween), text_color=color.gray, text_size=size.small)
